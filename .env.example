# LITREV-AI — Variables de entorno
# Copiar este archivo como .env y completar con tus credenciales.
# El archivo .env NUNCA se sube a git (está en .gitignore).

# OpenAlex (polite pool — mayor rate limit). Solo requiere un email válido.
OPENALEX_EMAIL=tu_email@ejemplo.com
# Opcional: clave premium de OpenAlex (dejar vacía si no se tiene)
OPENALEX_API_KEY=

# Semantic Scholar (opcional; sin clave funciona con rate limit más bajo)
SEMANTIC_SCHOLAR_API_KEY=

# Unpaywall (solo requiere email)
UNPAYWALL_EMAIL=tu_email@ejemplo.com

# CORE (opcional) — agregador de acceso abierto. Clave gratuita en:
# https://core.ac.uk/services/api  (registrarse → "Get API key").
# Si se deja vacía, la cascada de descarga simplemente omite CORE.
CORE_API_KEY=

# Opcional: ubicación alternativa del corpus de datos.
# Si se deja vacío, se usa la carpeta data/ dentro del repositorio.
# Útil para apuntar el corpus a Google Drive sin meter los PDFs en git.
# Ejemplo Windows: LITREV_DATA_DIR=D:\corpus\mi_revision
LITREV_DATA_DIR=
